#!/usr/bin/env bash
#
# gpu-power-control -- manage the primary GPU used by KWin Wayland.
#
# Two mechanisms (see README.md):
#   1. Login profile  -> KWin renders on the NVIDIA dGPU by default. A confirmed
#      restart-amd command selects AMD for one session. (per-user file)
#   2. Live power rule -> udev pins the dGPU awake while that screen is plugged
#      in, so it never sleeps out from under KWin. (system file, needs root)
#
# Usage: gpu-power-control {status|install|uninstall|on|auto|notify|restart-amd|restart-nvidia|help}

set -u

REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
COMP="$REPO_DIR/components"

ENV_SRC="$COMP/10-nvidia-docked-primary.sh"
HELPER_SRC="$COMP/nvidia-external-display-power.sh"
RULE_SRC="$COMP/61-nvidia-external-display-power.rules"
NOTIFY_SRC="$COMP/gpu-power-notify.sh"
WARNING_SRC="$COMP/gpu-power-warning.sh"
SWITCH_SRC="$COMP/gpu-session-switch.sh"

ENV_DST="$HOME/.config/plasma-workspace/env/10-nvidia-docked-primary.sh"
HELPER_DST="/usr/local/bin/nvidia-external-display-power.sh"
RULE_DST="/etc/udev/rules.d/61-nvidia-external-display-power.rules"
AUTOSTART_DST="$HOME/.config/autostart/gpu-power-notify.desktop"
USER_DATA_DST="${XDG_DATA_HOME:-$HOME/.local/share}/gpu-power-control"
USER_UNITS_DST="$HOME/.config/systemd/user"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/gpu-power-control"
COMMAND_DST="$HOME/.local/bin/gpu-power-control"

# ---------- styling ----------
if [ -t 1 ]; then B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; D=$'\033[2m'; Z=$'\033[0m'
else B=""; G=""; Y=""; R=""; D=""; Z=""; fi
ok()   { printf '  %s✓%s %s\n' "$G" "$Z" "$1"; }
no()   { printf '  %s✗%s %s\n' "$R" "$Z" "$1"; }
warn() { printf '  %s!%s %s\n'      "$Y" "$Z" "$1"; }
head() { printf '\n%s%s%s\n' "$B" "$1" "$Z"; }

# ---------- detection ----------
detect_nvidia_pci() {
    local d
    for d in /sys/bus/pci/drivers/nvidia/0000:*; do
        [ -e "$d" ] && { basename "$d"; return 0; }
    done
    lspci -D 2>/dev/null | awk 'tolower($0) ~ /nvidia/ && /VGA|3D|Display/ {print $1; exit}'
}

nvidia_external_connected() {   # $1 = nvidia pci
    local s dev
    for s in /sys/class/drm/*/status; do
        [ -e "$s" ] || continue
        dev=$(readlink -f "$(dirname "$s")/device" 2>/dev/null)
        case "$dev" in
            *"$1"*) [ "$(cat "$s" 2>/dev/null)" = connected ] && return 0 ;;
        esac
    done
    return 1
}

session_env() {   # $1 = var name; prints value from a readable session process
    local p line
    # plasmashell inherits the env exported by the login profile and (unlike
    # kwin_wayland) is dumpable, so its /proc/<pid>/environ is readable by us.
    for p in $(pgrep -x plasmashell) $(pgrep -x kwin_wayland); do
        [ -r "/proc/$p/environ" ] || continue
        line=$(tr '\0' '\n' < "/proc/$p/environ" | grep -m1 "^$1=")
        [ -n "$line" ] && { printf '%s\n' "${line#*=}"; return 0; }
    done
    return 1
}

need_nvidia() {
    NV_PCI="$(detect_nvidia_pci)"
    if [ -z "${NV_PCI:-}" ]; then
        echo "${R}No NVIDIA GPU found (driver not bound).${Z}" >&2
        exit 1
    fi
}

write_pm() {   # $1 = on|auto
    need_nvidia
    local path="/sys/bus/pci/devices/$NV_PCI/power/control"
    if [ -w "$path" ]; then
        echo "$1" > "$path"
    else
        echo "$1" | sudo tee "$path" >/dev/null || { echo "${R}failed to write $path${Z}" >&2; exit 1; }
    fi
    echo "NVIDIA ($NV_PCI) power/control = ${B}$1${Z}"
}

# ---------- commands ----------
cmd_status() {
    need_nvidia
    local pmc="/sys/bus/pci/devices/$NV_PCI/power/control"
    local rts="/sys/bus/pci/devices/$NV_PCI/power/runtime_status"

    head "GPUs / display routing"
    printf '  NVIDIA dGPU : %s\n' "$NV_PCI"
    for s in /sys/class/drm/*/status; do
        [ -e "$s" ] || continue
        dev=$(readlink -f "$(dirname "$s")/device" 2>/dev/null)
        case "$dev" in
            *"$NV_PCI"*) printf '    %-14s %s %s(NVIDIA)%s\n' "$(basename "$(dirname "$s")")" "$(cat "$s")" "$D" "$Z" ;;
            *)           printf '    %-14s %s\n' "$(basename "$(dirname "$s")")" "$(cat "$s")" ;;
        esac
    done
    if nvidia_external_connected "$NV_PCI"; then
        ok "external screen on the NVIDIA card is connected"
    else
        warn "no external screen on the NVIDIA card"
    fi

    head "NVIDIA power"
    printf '  power/control  = %s\n' "$([ -e "$pmc" ] && cat "$pmc" || echo '?')"
    printf '  runtime_status = %s\n' "$([ -e "$rts" ] && cat "$rts" || echo '?')"
    if command -v nvidia-smi >/dev/null; then
        printf '  %s\n' "$(nvidia-smi --query-gpu=pstate,power.draw,utilization.gpu --format=csv,noheader 2>/dev/null \
                 | awk -F', ' '{printf "pstate=%s  draw=%s  util=%s", $1,$2,$3}')"
    fi

    head "KWin render GPU (current session)"
    local val
    if ! pgrep -x kwin_wayland >/dev/null 2>&1; then
        warn "kwin_wayland not running"
    elif val=$(session_env KWIN_DRM_DEVICES); then
        # Resolve the first listed node + the NVIDIA by-path node to real cardN and
        # compare, so detection works for both cardN and by-path KWIN_DRM_DEVICES.
        first_real=$(readlink -f "${val%%:*}" 2>/dev/null)
        nv_card=$(readlink -f "/dev/dri/by-path/pci-${NV_PCI}-card" 2>/dev/null)
        if [ -n "$nv_card" ] && [ "$first_real" = "$nv_card" ]; then
            ok "rendering on NVIDIA  ($val)"
        else
            warn "KWIN_DRM_DEVICES=$val (NVIDIA not first)"
        fi
    else
        warn "rendering on the AMD iGPU (KWIN_DRM_DEVICES not set) -- use restart-nvidia to switch"
    fi

    head "Session policy"
    printf '  default renderer = NVIDIA\n'
    if [ -s "$STATE_DIR/next-session-mode" ]; then
        printf '  next session    = %s (one shot)\n' "$(cat "$STATE_DIR/next-session-mode")"
    else
        printf '  next session    = NVIDIA (default)\n'
    fi
    for timer in gpu-power-dock-watch.timer gpu-power-battery-warning.timer; do
        if systemctl --user is-enabled --quiet "$timer" 2>/dev/null; then
            ok "$timer enabled"
        else
            warn "$timer not enabled"
        fi
    done

    head "Installed components"
    insync() { [ -e "$2" ] && cmp -s "$1" "$2"; }
    if [ -e "$ENV_DST" ]; then
        insync "$ENV_SRC" "$ENV_DST" && ok "login profile      $ENV_DST" || warn "login profile (out of sync) $ENV_DST"
    else no "login profile      (not installed)"; fi
    if [ -e "$HELPER_DST" ]; then
        insync "$HELPER_SRC" "$HELPER_DST" && ok "power helper       $HELPER_DST" || warn "power helper (out of sync) $HELPER_DST"
    else no "power helper       (not installed)"; fi
    if [ -e "$RULE_DST" ]; then
        insync "$RULE_SRC" "$RULE_DST" && ok "udev rule          $RULE_DST" || warn "udev rule (out of sync) $RULE_DST"
    else no "udev rule          (not installed)"; fi
    if [ -e "$AUTOSTART_DST" ]; then ok "login notification $AUTOSTART_DST"
    else no "login notification (not installed)"; fi
    if [ -x "$USER_DATA_DST/gpu-power-warning.sh" ] && [ -x "$USER_DATA_DST/gpu-session-switch.sh" ]; then
        ok "warning/switch helpers $USER_DATA_DST"
    else no "warning/switch helpers (not installed)"; fi
    if [ -L "$COMMAND_DST" ] && [ "$(readlink -f "$COMMAND_DST")" = "$REPO_DIR/gpu-power-control" ]; then
        ok "command link         $COMMAND_DST"
    else warn "command link not installed at $COMMAND_DST"; fi
    echo
}

cmd_install() {
    head "Installing command"
    mkdir -p "$(dirname "$COMMAND_DST")"
    ln -sfn "$REPO_DIR/gpu-power-control" "$COMMAND_DST" && ok "$COMMAND_DST"

    head "Installing login profile (no root needed)"
    install -D -m0755 "$ENV_SRC" "$ENV_DST" && ok "$ENV_DST"

    head "Installing login notification (no root needed)"
    install -m0755 "$NOTIFY_SRC" "$NOTIFY_SRC" 2>/dev/null; chmod +x "$NOTIFY_SRC"
    mkdir -p "$(dirname "$AUTOSTART_DST")"
    cat > "$AUTOSTART_DST" <<EOF
[Desktop Entry]
Type=Application
Name=GPU status notification
Comment=Show which GPU KWin is rendering on at login
Exec=$NOTIFY_SRC
Icon=video-display
Terminal=false
OnlyShowIn=KDE;
X-KDE-autostart-phase=2
EOF
    ok "$AUTOSTART_DST"

    head "Installing dock and battery warnings"
    install -D -m0755 "$WARNING_SRC" "$USER_DATA_DST/gpu-power-warning.sh" && ok "$USER_DATA_DST/gpu-power-warning.sh"
    install -D -m0755 "$SWITCH_SRC" "$USER_DATA_DST/gpu-session-switch.sh" && ok "$USER_DATA_DST/gpu-session-switch.sh"
    for unit in gpu-power-dock-watch.service gpu-power-dock-watch.timer \
                gpu-power-battery-warning.service gpu-power-battery-warning.timer; do
        install -D -m0644 "$COMP/$unit" "$USER_UNITS_DST/$unit" && ok "$USER_UNITS_DST/$unit"
    done
    systemctl --user daemon-reload
    systemctl --user enable --now gpu-power-dock-watch.timer gpu-power-battery-warning.timer \
        && ok "dock watcher and battery reminder enabled"

    head "Installing live power rule (needs root)"
    sudo install -D -m0755 "$HELPER_SRC" "$HELPER_DST" && ok "$HELPER_DST"
    sudo install -D -m0644 "$RULE_SRC" "$RULE_DST"     && ok "$RULE_DST"
    sudo udevadm control --reload-rules && ok "udev rules reloaded"

    # Apply current power state immediately instead of waiting for a hotplug.
    sudo "$HELPER_DST" && ok "applied current power state"

    head "Done"
    if nvidia_external_connected "$(detect_nvidia_pci)"; then
        printf '  %sRun %s restart-nvidia%s to move this session to the NVIDIA GPU.\n' "$B" "$(basename "$0")" "$Z"
    else
        echo "  NVIDIA is now the default renderer for the next graphical login."
    fi
    echo "  A notification will show the active GPU at each login."
    echo "  Run '$(basename "$0") status' any time to check, or 'notify' to preview the popup."
}

cmd_uninstall() {
    head "Removing command"
    if [ -L "$COMMAND_DST" ] && [ "$(readlink -f "$COMMAND_DST")" = "$REPO_DIR/gpu-power-control" ]; then
        rm -f "$COMMAND_DST" && ok "removed $COMMAND_DST"
    else
        warn "command link not present or points elsewhere"
    fi

    head "Removing login profile"
    [ -e "$ENV_DST" ] && rm -f "$ENV_DST" && ok "removed $ENV_DST" || warn "not present"

    head "Removing login notification"
    [ -e "$AUTOSTART_DST" ] && rm -f "$AUTOSTART_DST" && ok "removed $AUTOSTART_DST" || warn "not present"

    head "Removing dock and battery warnings"
    systemctl --user disable --now gpu-power-dock-watch.timer gpu-power-battery-warning.timer 2>/dev/null || true
    for unit in gpu-power-dock-watch.service gpu-power-dock-watch.timer \
                gpu-power-battery-warning.service gpu-power-battery-warning.timer; do
        [ -e "$USER_UNITS_DST/$unit" ] && rm -f "$USER_UNITS_DST/$unit"
    done
    rm -f "$USER_DATA_DST/gpu-power-warning.sh" "$USER_DATA_DST/gpu-session-switch.sh"
    systemctl --user daemon-reload
    ok "removed user warning units and helpers"

    head "Removing live power rule (needs root)"
    [ -e "$HELPER_DST" ] && sudo rm -f "$HELPER_DST" && ok "removed $HELPER_DST" || warn "helper not present"
    [ -e "$RULE_DST" ]   && sudo rm -f "$RULE_DST"   && ok "removed $RULE_DST"   || warn "rule not present"
    sudo udevadm control --reload-rules && ok "udev rules reloaded"

    head "Restoring default power management"
    write_pm auto
    echo "  Log out and back in to return rendering to the AMD iGPU."
}

cmd_help() {
    cat <<EOF
${B}gpu-power-control${Z} -- primary-GPU and power policy for KWin Wayland

${B}Usage:${Z} $(basename "$0") <command>

  ${B}status${Z}     Show GPU routing, NVIDIA power state, KWin's render GPU,
             and which components are installed.
  ${B}install${Z}    Install the login profile + live power rule (uses sudo).
  ${B}uninstall${Z}  Remove everything and restore default power management.
  ${B}on${Z}         Force the NVIDIA dGPU powered on now (live override).
  ${B}auto${Z}       Let the NVIDIA dGPU runtime-suspend again (live override).
  ${B}notify${Z}     Pop the "which GPU am I using" notification now (test it).
  ${B}restart-amd${Z}      Confirm, then log out and use AMD for the next session only.
  ${B}restart-nvidia${Z}   Confirm, then log out and use NVIDIA (the default).
  ${B}help${Z}       Show this help.

Files live in: $REPO_DIR
EOF
}

case "${1:-status}" in
    status)            cmd_status ;;
    install)           cmd_install ;;
    uninstall|remove)  cmd_uninstall ;;
    on)                write_pm on ;;
    auto|off)          write_pm auto ;;
    notify)            exec "$NOTIFY_SRC" ;;
    restart-amd)       exec "$SWITCH_SRC" amd ;;
    restart-nvidia)    exec "$SWITCH_SRC" nvidia ;;
    help|-h|--help)    cmd_help ;;
    *) echo "unknown command: $1" >&2; echo; cmd_help; exit 1 ;;
esac
